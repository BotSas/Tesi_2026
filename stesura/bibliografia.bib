  author = {Li, Dan and Liu, Xinyi and Dong, Fanli and Li, Wanwan},
  date = {2025},
  journaltitle = {Journal of Materials Chemistry B},
  shortjournal = {J. Mater. Chem. B},
  volume = {13},
  number = {2},
  pages = {472--484},
  issn = {2050-750X, 2050-7518},
  doi = {10.1039/D4TB01669F},
