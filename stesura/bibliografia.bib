@article{redfordPolarPlotRepresentation2005,
  title = {Polar {{Plot Representation}} for {{Frequency-Domain Analysis}} of {{Fluorescence Lifetimes}}},
  author = {Redford, Glen I. and Clegg, Robert M.},
  date = {2005-09-01},
  journaltitle = {Journal of Fluorescence},
  shortjournal = {J Fluoresc},
