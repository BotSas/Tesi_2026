@article{malacridaPhasorPlotUniversal2021,
  title = {The {{Phasor Plot}}: {{A Universal Circle}} to {{Advance Fluorescence Lifetime Analysis}} and {{Interpretation}}},
  shorttitle = {The {{Phasor Plot}}},
  author = {Malacrida, Leonel and Ranjit, Suman and Jameson, David M. and Gratton, Enrico},
