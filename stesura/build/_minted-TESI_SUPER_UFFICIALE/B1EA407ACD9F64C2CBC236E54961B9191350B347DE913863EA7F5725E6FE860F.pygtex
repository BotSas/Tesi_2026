    \PYG{n}{eigenvectors} \PYG{o}{=} \PYG{n}{eigenvectors}\PYG{p}{[:,} \PYG{p}{::}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}

