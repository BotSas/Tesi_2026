\PYG{k}{def} \PYG{n+nf}{cloud\PYGZus{}statistics}\PYG{p}{(}\PYG{n}{G}\PYG{p}{,} \PYG{n}{S}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZsq{}\PYGZsq{}\PYGZsq{}}
\PYG{l+s+sd}{    Mean, average, covarance matrix and diagonalisation of ph. cloud}
\PYG{l+s+sd}{    \PYGZsq{}\PYGZsq{}\PYGZsq{}}
    \PYG{n}{values} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{column\PYGZus{}stack}\PYG{p}{((}\PYG{n}{np}\PYG{o}{.}\PYG{n}{asarray}\PYG{p}{(}\PYG{n}{G}\PYG{p}{,} \PYG{n}{dtype} \PYG{o}{=} \PYG{n+nb}{float}\PYG{p}{),}
                            \PYG{n}{np}\PYG{o}{.}\PYG{n}{asarray}\PYG{p}{(}\PYG{n}{S}\PYG{p}{,} \PYG{n}{dtype} \PYG{o}{=} \PYG{n+nb}{float}\PYG{p}{)))}
    \PYG{n}{values} \PYG{o}{=} \PYG{n}{values}\PYG{p}{[}\PYG{n}{np}\PYG{o}{.}\PYG{n}{all}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{isfinite}\PYG{p}{(}\PYG{n}{values}\PYG{p}{),} \PYG{n}{axis} \PYG{o}{=} \PYG{l+m+mi}{1}\PYG{p}{)]}

    \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{values}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{2}\PYG{p}{:}  \PYG{c+c1}{\PYGZsh{} error prevention}
        \PYG{k}{raise} \PYG{n+ne}{ValueError}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Not enough events\PYGZdq{}}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} NUMPY COVARIANCE}
    \PYG{n}{mean} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{values}\PYG{p}{,} \PYG{n}{axis} \PYG{o}{=} \PYG{l+m+mi}{0}\PYG{p}{)}
    \PYG{n}{covariance} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{cov}\PYG{p}{(}\PYG{n}{values}\PYG{p}{,} \PYG{n}{rowvar} \PYG{o}{=} \PYG{k+kc}{False}\PYG{p}{,} \PYG{n}{ddof} \PYG{o}{=} \PYG{l+m+mi}{1}\PYG{p}{)}
