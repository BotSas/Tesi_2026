": false, "is_published": true, "links": {"access": "https://zenodo.org/api/records/16894639/access", "access_grants": "https://zenodo.org/api/records/16894639/access/grants", "access_links": "https://zenodo.org/api/records/16894639/access/links", "access_request": "https://zenodo.org/api/records/16894639/access/request", "access_users": "https://zenodo.org/api/records/16894639/access/users", "archive": "https://zenodo.org/api/records/16894639/files-archive", "archive_media": "https://zenodo.org/api/records/16894639/media-files-archive", "communities": "https://zenodo.org/api/records/16894639/communities", "communities-suggestions": "https://zenodo.org/api/records/16894639/communities-suggestions", "doi": "https://doi.org/10.5281/zenodo.16894639", "draft": "https://zenodo.org/api/records/16894639/draft", "file_modification": "https://zenodo.org/api/records/16894639/file-modification", "files": "https://zenodo.org/api/records/16894639/files", "latest": "https://zenodo.org/api/records/16894639/versions/latest", "latest_html": "https://zenodo.org/records/16894639/latest", "media_files": "https://zenodo.org/api/records/16894639/media-files", "parent": "https://zenodo.org/api/records/16894638", "parent_doi": "https://doi.org/10.5281/zenodo.16894638", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.16894638", "parent_html": "https://zenodo.org/records/16894638", "preview_html": "https://zenodo.org/records/16894639?preview=1", "quota_increase": "https://zenodo.org/api/records/16894639/quota-increase", "request_deletion": "https://zenodo.org/api/records/16894639/request-deletion", "requests": "https://zenodo.org/api/records/16894639/requests", "reserve_doi": "https://zenodo.org/api/records/16894639/draft/pids/doi", "self": "https://zenodo.org/api/records/16894639", "self_doi": "https://doi.org/10.5281/zenodo.16894639", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.16894639", "self_html": "https://zenodo.org/records/16894639", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:16894639/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:16894639/sequence/default", "versions": "https://zenodo.org/api/records/16894639/versions"}, "media_files": {"count": 0, "enabled": false, "entries": {}, "order": [], "total_bytes": 0}, "metadata": {"creators": [{"affiliations": [{"name": "Universidad de la Rep\u00fablica Facultad de Medicina"}, {"name": "Pasteur Institute of Montevideo"}], "person_or_org": {"family_name": "Malacrida", "given_name": "Leonel", "identifiers": [{"identifier": "0000-0001-6253-9229", "scheme": "orcid"}], "name": "Malacrida, Leonel", "type": "personal"}, "role": {"id": "datacollector", "title": {"de": "DatensammlerIn", "en": "Data collector"}}}, {"affiliations": [{"id": "04dpm2z73", "identifiers": [{"identifier": "04dpm2z73", "scheme": "ror"}, {"identifier": "grid.418532.9", "scheme": "grid"}, {"identifier": "0000 0004 0403 6035", "scheme": "isni"}], "name": "Institut Pasteur de Montevideo"}], "person_or_org": {"family_name": "Pannunzio", "given_name": "Bruno", "identifiers": [{"identifier": "0009-0001-2778-6694", "scheme": "orcid"}], "name": "Pannunzio, Bruno", "type": "personal"}, "role": {"id": "datacurator", "title": {"de": "DatenkuratorIn", "en": "Data curator"}}}], "dates": [{"date": "2017-07-11", "type": {"id": "accepted", "title": {"de": "Angenommen", "en": "Accepted"}}}], "description": "\u003cp\u003eThis dataset contains hyperspectral imaging (HSI) and fluorescence lifetime imaging microscopy (FLIM) acquisitions of NIH-3T3 fibroblast cells stained with the membrane probe LAURDAN (6-dodecanoyl-2-dimethylaminonaphthalene). The data were generated and analyzed in the study \u003cem\u003e\u0026ldquo;A multidimensional phasor approach reveals LAURDAN photophysics in NIH-3T3 cell membranes\u0026rdquo;\u003c/em\u003e (DOI: \u003ca target=\"_new\" rel=\"noopener\"\u003e10.1038/s41598-017-08564-z\u003c/a\u003e).\u003c/p\u003e\n\u003cp\u003eThese measurements were used to demonstrate multidimensional phasor analysis, a model-free approach that combines spectral and lifetime information at the pixel level. This methodology enabled the separation of polarity effects from dipolar relaxation in cellular membranes and revealed the heterogeneous photophysics of LAURDAN across different membrane regions.\u003c/p\u003e\n\u003cp\u003eThe dataset can be used to reproduce the analyses presented in the publication and as a reference resource for developing or benchmarking spectral, lifetime, and multidimensional phasor analysis methods in bioimaging.\u003c/p\u003e\n\u003cp\u003eFor the FBD files, a laser frequency factor of 0.99168 is recommended to ensure correct reading.\u003c/p\u003e", "publication_date": "2025-08-18", "publisher": "Zenodo", "resource_type": {"id": "image", "title": {"de": "Bild", "en": "Image"}}, "rights": [{"description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title": {"en": "Creative Commons Attribution 4.0 International"}}], "title": "Hyperspectral and Fluorescence Lifetime Imaging Microscopy of LAURDAN-Stained NIH-3T3 Cells"}, "parent": {"access": {"owned_by": {"user": "1197389"}, "settings": {"accept_conditions_text": null, "allow_guest_requests": false, "allow_user_requests": false, "secret_link_expiration": 0}}, "communities": {"default": "38346079-96d4-42bc-ad0f-74bf372e2492", "entries": [{"access": {"member_policy": "open", "members_visibility": "public", "record_submission_policy": "open", "review_policy": "open", "visibility": "public"}, "children": {"allow": false}, "created": "2023-10-05T14:08:06.379306+00:00", "custom_fields": {}, "deletion_status": {"is_deleted": false, "status": "P"}, "id": "38346079-96d4-42bc-ad0f-74bf372e2492", "links": {}, "metadata": {"description": "An open-source Python library for the analysis of fluorescence lifetime and hyperspectral images using the phasor approach.", "organizations": [{"name": "PhasorPy"}], "page": "\u003cp\u003eA community to host material for testing, outreach, and dissemination of the \u003ca href=\"https://www.phasorpy.org\"\u003ePhasorPy\u003c/a\u003e project.\u003c/p\u003e\n\n\u003cp\u003ePhasorPy is an open-source Python library for the analysis of fluorescence lifetime and hyperspectral images using the phasor approach.\u003c/p\u003e", "title": "PhasorPy", "type": {"id": "project"}, "website": "https://www.phasorpy.org"}, "revision_id": 2, "slug": "phasorpy", "updated": "2025-08-22T22:45:46.847882+00:00"}], "ids": ["38346079-96d4-42bc-ad0f-74bf372e2492"]}, "id": "16894638", "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.16894638", "provider": "datacite"}}}, "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.16894639", "provider": "datacite"}, "oai": {"identifier": "oai:zenodo.org:16894639", "provider": "oai"}}, "revision_id": 4, "stats": {"all_versions": {"data_volume": 10002149412.0, "downloads": 392, "unique_downloads": 388, "unique_views": 139, "views": 151}, "this_version": {"data_volume": 10002149412.0, "downloads": 392, "unique_downloads": 388, "unique_views": 139, "views": 151}}, "status": "published", "swh": {}, "ui": {"access_status": {"description_l10n": "The record and files are publicly accessible.", "embargo_date_l10n": null, "icon": "unlock", "id": "open", "message_class": "", "title_l10n": "Open"}, "created_date_l10n_long": "August 18, 2025", "creators": {"affiliations": [[1, "Universidad de la Rep\u00fablica Facultad de Medicina", null], [2, "Pasteur Institute of Montevideo", null], [3, "Institut Pasteur de Montevideo", "04dpm2z73"]], "creators": [{"affiliations": [[1, "Universidad de la Rep\u00fablica Facultad de Medicina"], [2, "Pasteur Institute of Montevideo"]], "person_or_org": {"family_name": "Malacrida", "given_name": "Leonel", "identifiers": [{"identifier": "0000-0001-6253-9229", "scheme": "orcid"}], "name": "Malacrida, Leonel", "type": "personal"}, "role": {"id": "datacollector", "title": "Data collector"}}, {"affiliations": [[3, "Institut Pasteur de Montevideo"]], "person_or_org": {"family_name": "Pannunzio", "given_name": "Bruno", "identifiers": [{"identifier": "0009-0001-2778-6694", "scheme": "orcid"}], "name": "Pannunzio, Bruno", "type": "personal"}, "role": {"id": "datacurator", "title": "Data curator"}}]}, "custom_fields": {"journal:journal": {"issn": "2045-2322", "title": "Scientific Reports"}}, "dates": [{"date": "2017-07-11", "type": {"id": "accepted", "title_l10n": "Accepted"}}], "description_stripped": "This dataset contains hyperspectral imaging (HSI) and fluorescence lifetime imaging microscopy (FLIM) acquisitions of NIH-3T3 fibroblast cells stained with the membrane probe LAURDAN (6-dodecanoyl-2-dimethylaminonaphthalene). The data were generated and analyzed in the study \u201cA multidimensional phasor approach reveals LAURDAN photophysics in NIH-3T3 cell membranes\u201d (DOI: 10.1038/s41598-017-08564-z).\n\nThese measurements were used to demonstrate multidimensional phasor analysis, a model-free approach that combines spectral and lifetime information at the pixel level. This methodology enabled the separation of polarity effects from dipolar relaxation in cellular membranes and revealed the heterogeneous photophysics of LAURDAN across different membrane regions.\n\nThe dataset can be used to reproduce the analyses presented in the publication and as a reference resource for developing or benchmarking spectral, lifetime, and multidimensional phasor analysis methods in bioimaging.\n\nFor the FBD files, a laser frequency factor of 0.99168 is recommended to ensure correct reading.", "is_draft": false, "publication_date_l10n_long": "August 18, 2025", "publication_date_l10n_medium": "Aug 18, 2025", "publishing_information": {"journal": "Scientific Reports, ISSN: 2045-2322, 2025."}, "resource_type": {"id": "image", "title_l10n": "Image"}, "rights": [{"description_l10n": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited.", "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title_l10n": "Creative Commons Attribution 4.0 International"}], "updated_date_l10n_long": "August 18, 2025", "version": "v1"}, "updated": "2025-08-18T16:27:21.081236+00:00", "versions": {"index": 1, "is_latest": true}}'
