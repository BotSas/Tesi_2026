      <script type='application/ld+json'>{"@context": "http://schema.org", "@id": "https://doi.org/10.5281/zenodo.16894639", "@type": "https://schema.org/ImageObject", "ISSN": "2045-2322", "author": [{"@id": "https://orcid.org/0000-0001-6253-9229", "@type": "Person", "affiliation": [{"@type": "Organization", "name": "Universidad de la Rep\u00fablica Facultad de Medicina"}, {"@type": "Organization", "name": "Pasteur Institute of Montevideo"}], "familyName": "Malacrida", "givenName": "Leonel", "name": "Malacrida, Leonel"}, {"@id": "https://orcid.org/0009-0001-2778-6694", "@type": "Person", "affiliation": [{"@id": "https://ror.org/04dpm2z73", "@type": "Organization", "name": "Institut Pasteur de Montevideo"}], "familyName": "Pannunzio", "givenName": "Bruno", "name": "Pannunzio, Bruno"}], "container_title": "Scientific Reports", "contentSize": "127.84 MB", "creator": [{"@id": "https://orcid.org/0000-0001-6253-9229", "@type": "Person", "affiliation": [{"@type": "Organization", "name": "Universidad de la Rep\u00fablica Facultad de Medicina"}, {"@type": "Organization", "name": "Pasteur Institute of Montevideo"}], "familyName": "Malacrida", "givenName": "Leonel", "name": "Malacrida, Leonel"}, {"@id": "https://orcid.org/0009-0001-2778-6694", "@type": "Person", "affiliation": [{"@id": "https://ror.org/04dpm2z73", "@type": "Organization", "name": "Institut Pasteur de Montevideo"}], "familyName": "Pannunzio", "givenName": "Bruno", "name": "Pannunzio, Bruno"}], "dateCreated": "2025-08-18T16:27:20.764173+00:00", "dateModified": "2025-08-18T16:27:21.081236+00:00", "datePublished": "2025-08-18", "description": "\u003cp\u003eThis dataset contains hyperspectral imaging (HSI) and fluorescence lifetime imaging microscopy (FLIM) acquisitions of NIH-3T3 fibroblast cells stained with the membrane probe LAURDAN (6-dodecanoyl-2-dimethylaminonaphthalene). The data were generated and analyzed in the study \u003cem\u003e\u0026ldquo;A multidimensional phasor approach reveals LAURDAN photophysics in NIH-3T3 cell membranes\u0026rdquo;\u003c/em\u003e (DOI: \u003ca target=\"_new\" rel=\"noopener\"\u003e10.1038/s41598-017-08564-z\u003c/a\u003e).\u003c/p\u003e\n\u003cp\u003eThese measurements were used to demonstrate multidimensional phasor analysis, a model-free approach that combines spectral and lifetime information at the pixel level. This methodology enabled the separation of polarity effects from dipolar relaxation in cellular membranes and revealed the heterogeneous photophysics of LAURDAN across different membrane regions.\u003c/p\u003e\n\u003cp\u003eThe dataset can be used to reproduce the analyses presented in the publication and as a reference resource for developing or benchmarking spectral, lifetime, and multidimensional phasor analysis methods in bioimaging.\u003c/p\u003e\n\u003cp\u003eFor the FBD files, a laser frequency factor of 0.99168 is recommended to ensure correct reading.\u003c/p\u003e", "identifier": "https://doi.org/10.5281/zenodo.16894639", "license": "https://creativecommons.org/licenses/by/4.0/legalcode", "name": "Hyperspectral and Fluorescence Lifetime Imaging Microscopy of LAURDAN-Stained NIH-3T3 Cells", "publisher": {"@type": "Organization", "name": "Zenodo"}, "size": "127.84 MB", "temporal": ["2017-07-11"], "url": "https://zenodo.org/records/16894639"}</script>

